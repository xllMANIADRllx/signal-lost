{
  "name": "signal-lost",
  "version": "1.3.3",
  "description": "Signal Lost — Rogue AI Containment Failure",
  "author": "xllMANIADRllx",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.signallost.game",
    "productName": "Signal Lost",
    "publish": {
      "provider": "github",
      "owner": "xllMANIADRllx",
      "repo": "signal-lost",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "extraFiles": [
        {
          "from": "README-MAC.txt",
          "to": "../README-MAC.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "index.html",
      "src/**/*",
      "main.js",
      "preload.js"
    ]
  },
  "dependencies": {
    "electron-updater": "6.1.7",
    "electron-log": "5.1.2"
  },
  "devDependencies": {
    "electron": "33.0.0",
    "electron-builder": "24.9.1"
  }
}
